{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "outDir": "node_modules/.tmp/tsconfig.node",
    "strict": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["vite.config.js"]
}
